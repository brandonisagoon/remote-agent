{
  "$schema": "./remote-agent.config.schema.json",
  "schemaVersion": 2,
  "serviceName": "remote-agent",
  "machine": {
    "id": "studio-mac",
    "name": "Studio Mac",
    "acceptsTrackerInput": true,
    "server": {
      "publicUrl": "https://agents.example.com",
      "apiKey": "replace-with-a-long-random-api-key",
      "listen": {
        "host": "127.0.0.1",
        "port": 9000
      },
      "databaseUrl": "file:./remote-agent.sqlite",
      "acpSocketPath": "~/Library/Application Support/remote-agent/acp.sock",
      "controlSocketPath": "~/Library/Application Support/remote-agent/control.sock",
      "webhooks": {
        "linear-product": {
          "connection": "linear-main",
          "secret": "replace-with-linear-webhook-secret",
          "webhookMaxAgeMs": 60000,
          "repositoryRouting": {
            "your-repository": {}
          }
        },
        "github": {
          "connection": "github-main",
          "secret": "replace-with-github-webhook-secret"
        }
      }
    },
    "zed": {
      "connection": "local"
    },
    "acpx": {
      "stateDir": "~/Library/Application Support/remote-agent/acpx",
      "permissionMode": "approve-all",
      "nonInteractivePermissions": "deny",
      "agents": {}
    },
    "runtime": {
      "codexExecutable": "codex",
      "routerTimeoutMs": 30000
    },
    "acp": {
      "provider": "codex"
    },
    "installation": {
      "gitRemote": "https://github.com/brandonisagoon/remote-agent.git",
      "branch": "main"
    },
    "updates": {
      "channel": "stable"
    }
  },
  "connections": {
    "linear-main": {
      "provider": "linear",
      "name": "Linear Product",
      "apiKey": "replace-with-linear-api-key",
      "agentUserId": "replace-with-linear-agent-user-id",
      "agentHandle": "agent"
    },
    "github-main": {
      "provider": "github",
      "name": "GitHub Deploy"
    }
  },
  "repositories": {
    "your-repository": {
      "name": "Your Repository",
      "root": "~/checkouts/your-repository",
      "worktreeRoot": "../.worktrees/your-repository",
      "bootstrapCommand": ["bash", "scripts/bootstrap.sh"],
      "metadata": {
        "tags": {
          "example.workflow": {
            "options": ["planning", "implementation", "review"],
            "cardinality": "one",
            "routerVisible": true
          }
        }
      },
      "sessionDefaults": {
        "tags": {}
      },
      "triggers": {
        "reflectOnState": "Pull Request",
        "orchestrateOnState": "Planning",
        "describeOnReaction": "pencil2"
      },
      "workflows": {
        "describe": {
          "prompt": "prompts/describe-issue.md",
          "harness": "claude",
          "model": "opus"
        },
        "orchestrate": {
          "prompt": "prompts/orchestrate-plan.md",
          "harness": "codex"
        },
        "reflect": {
          "prompt": "prompts/reflect.md"
        }
      }
    }
  }
}
