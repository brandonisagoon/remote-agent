// Isolated from the product Prisma schema in the repository root.
//
// This app owns its own datasource (local SQLite), its own migrations, and its
// own generated client. It must never reach the product Postgres database, so
// prisma.config.ts reads the connection string from the private Remote Agent
// JSON rather than DATABASE_URL from the host repository environment.
//
// The product schema's prisma-zod-generator is deliberately NOT run here.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}
