/// Durable idempotency index from a harness session to its canonical Linear issue.
/// Linear remains the session registry; this table avoids search-index races.
model AgentIssueRecord {
  id                   String   @id @default(cuid())
  harnessSessionId     String   @unique
  agentIssueId         String
  agentIssueIdentifier String?
  machine              String?
  lastEventId          String?
  lastGeneration       BigInt?
  sessionRootCommentId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  runtimeSession RuntimeSession?

  @@index([machine])
}
