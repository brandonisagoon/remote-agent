{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "baseBranch": {
      "default": "main",
      "type": "string",
      "minLength": 1
    },
    "preparation": {
      "default": "command",
      "type": "string",
      "enum": [
        "command",
        "agent"
      ]
    },
    "bootstrapCommand": {
      "default": [
        "bash",
        "scripts/bootstrap.sh"
      ],
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skillsRoot": {
      "default": "agent-skills",
      "type": "string",
      "minLength": 1
    },
    "branchNaming": {
      "default": {
        "*": "{branch}"
      },
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(\\*|linear(:[a-z0-9][a-z0-9._-]*)?)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "workflows": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "connectionId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "on": {
            "type": "string",
            "enum": [
              "issue.state-changed",
              "issue.reaction",
              "comment.created",
              "comment.reaction"
            ]
          },
          "when": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "skill": {
            "default": {
              "skillset": "",
              "flags": []
            },
            "type": "object",
            "properties": {
              "skillset": {
                "type": "string"
              },
              "flags": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "skillset",
              "flags"
            ],
            "additionalProperties": false
          },
          "deliver": {
            "type": "string",
            "enum": [
              "start-session",
              "message-session",
              "queue-session",
              "steer-session"
            ]
          },
          "providerId": {
            "type": "string",
            "enum": [
              "codex",
              "claude"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "plan": {
            "type": "object",
            "properties": {
              "captureToIssue": {
                "type": "boolean",
                "const": true
              },
              "thenState": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "captureToIssue"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "on",
          "skill",
          "deliver"
        ],
        "additionalProperties": false
      }
    },
    "conversationReactions": {
      "type": "object",
      "properties": {
        "queued": {
          "type": "string",
          "minLength": 1
        },
        "processing": {
          "type": "string",
          "minLength": 1
        },
        "replied": {
          "type": "string",
          "minLength": 1
        },
        "attention": {
          "type": "string",
          "minLength": 1
        },
        "failed": {
          "type": "string",
          "minLength": 1
        },
        "planUpdate": {
          "type": "string",
          "minLength": 1
        },
        "codeChange": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "labels": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "labels": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exclusive": {
            "default": true,
            "type": "boolean"
          },
          "routerVisible": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "exclusive",
          "routerVisible"
        ],
        "additionalProperties": false
      }
    },
    "sessionDefaults": {
      "default": {
        "labels": {}
      },
      "type": "object",
      "properties": {
        "labels": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "labels"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "baseBranch",
    "preparation",
    "bootstrapCommand",
    "skillsRoot",
    "branchNaming",
    "workflows",
    "labels",
    "sessionDefaults"
  ],
  "additionalProperties": false
}
