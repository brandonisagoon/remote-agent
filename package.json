{
  "name": "remote-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Org-agnostic control plane for durable acpx-backed coding-agent sessions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandonisagoon/remote-agent.git"
  },
  "homepage": "https://github.com/brandonisagoon/remote-agent#readme",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "acp": "bun src/acp/main.ts",
    "serve": "bun --watch src/server.ts",
    "build": "prisma generate && tsc --noEmit",
    "lint": "prisma generate && tsc --noEmit",
    "start": "bun src/server.ts",
    "test": "bun test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@libsql/client": "0.17.4",
    "@prisma/adapter-libsql": "7.9.1",
    "@prisma/client": "7.9.1",
    "acpx": "0.13.2",
    "hono": "4.12.32",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "prisma": "7.9.1",
    "typescript": "5.9.3"
  }
}
